{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mako2kano/pmi-trainer/schemas/exams.schema.json",
  "title": "exams.json — 試験パラメータ（SPEC_v2.md §4 / DR-06）",
  "description": "模試の問題数・制限時間・ドメイン構成・UIテーマは本ファイルのみで駆動する（ハードコード禁止）。",
  "type": "object",
  "propertyNames": {
    "pattern": "^[a-z][a-z0-9_]*$"
  },
  "additionalProperties": {
    "type": "object",
    "required": ["name", "mock_questions", "mock_minutes", "domains", "theme"],
    "additionalProperties": false,
    "properties": {
      "name": { "type": "string", "minLength": 1 },
      "mock_questions": { "type": "integer", "minimum": 1 },
      "mock_minutes": { "type": "integer", "minimum": 1 },
      "domains": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": { "type": "string", "pattern": "^D[0-9]+$" }
      },
      "theme": { "type": "string", "minLength": 1 }
    }
  },
  "minProperties": 1
}
